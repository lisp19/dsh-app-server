{
  "name": "dsh-app-server-project",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Independent remote desktop client and server adapter for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lisp19/dsh-app-server.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:repository": "node scripts/check-repository.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "test": "node --test tests/*.test.mjs apps/electron/tests/*.test.mjs",
    "start": "npm start --workspace apps/electron",
    "prepack:server": "node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\"",
    "pack:server": "npm pack --workspace packages/server --pack-destination artifacts",
    "build:win": "npm run pack:win --workspace apps/electron --",
    "build:linux": "npm run pack:linux --workspace apps/electron --",
    "build:mac": "npm run pack:mac --workspace apps/electron --",
    "test:integration": "node scripts/integration.mjs",
    "prepare:integration": "node scripts/prepare-integration.mjs",
    "test:electron": "node scripts/electron-integration.mjs"
  },
  "overrides": {
    "fflate": "$fflate"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "fflate": "0.8.3",
    "playwright": "^1.58.2",
    "pnpm": "11.28.0",
    "ws": "^8.21.3"
  }
}
